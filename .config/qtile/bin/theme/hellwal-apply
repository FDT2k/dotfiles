#!/bin/bash
# Generate the theme from an image with hellwal, then recolor open terminals.
# The only place hellwal is called: appearance options live here, so that
# pick and reload always pass the same ones (hellwal caches the palette per
# image + options). Templates: ~/.config/hellwal/templates/ (pywal-compatible).

if [ -z "$1" ]; then
    echo "usage: $(basename "$0") <image>" >&2
    exit 2
fi

# hellwal may live outside the session PATH (Qtile does not read .zshrc):
# PATH first, then ~/.config/qtile/bin, ~/bin, ~/.local/bin.
QTILE_BIN="$(cd "$(dirname "$0")/.." && pwd)"
HELLWAL=$(command -v hellwal)
if [ -z "$HELLWAL" ]; then
    for candidate in "$QTILE_BIN/hellwal" "$HOME/bin/hellwal" "$HOME/.local/bin/hellwal"; do
        if [ -x "$candidate" ]; then
            HELLWAL="$candidate"
            break
        fi
    done
fi
if [ -z "$HELLWAL" ]; then
    echo "hellwal-apply: hellwal not found (PATH, $QTILE_BIN/hellwal, $HOME/bin/hellwal, $HOME/.local/bin/hellwal)" >&2
    exit 127
fi

mkdir -p "$HOME/.cache/wal"

"$HELLWAL" -i "$(realpath "$1")" -o "$HOME/.cache/wal" --comfort-mode --skip-term-colors -q || exit $?

TERMINAL_SH="$HOME/.cache/wal/terminal.sh"
[ -f "$TERMINAL_SH" ] || exit 0

for pts in /dev/pts/[0-9]*; do
    [ -w "$pts" ] || continue
    { sh "$TERMINAL_SH" > "$pts"; } 2>/dev/null || true
done

exit 0
