#!/usr/bin/env bash
#
# Script to set dunst colors generated by hellwal
# (~/.cache/wal/colors.sh, from ~/.config/hellwal/templates/colors.sh)
# Source generated colors.


. "${HOME}/.cache/wal/colors.sh"

echo ${color3}
echo ${color0}
reload_dunst() {
    echo "prout"
    pkill dunst
    dunst \
	      -frame_width 2 \
        -lfr "${color3}" \
        -nfr "${color3}" \
        -cfr "${color3}" \
        -lb "${color0}" \
        -nb "${color0}" \
        -cb "${color0}" \
        -lf "${color2}" \
        -bf "${color2}" \
        -cf "${color2}" \
        -nf "${color7}" &
}

reload_dunst