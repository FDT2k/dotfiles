#!/usr/bin/env bash
ARGS=()

EXEC="no"


export APP_PORT=${APP_PORT:-80}
export APP_SERVICE=${APP_SERVICE:-"laravel.test"}
export APP_USER=${APP_USER:-"agent"}
export WWWUSER=${WWWUSER:-$UID}
export WWWGROUP=${WWWGROUP:-$(id -g)}

export ROCKET_FILES=${ROCKET_FILES:-"rocket.yml"}  #docker compose files
export ROCKET_DOCKER_BINARY=${ROCKET_DOCKER_BINARY:-"docker"}

# Function that outputs Rocket is not running...
function rocket_is_not_running {
    echo "${BOLD}Rocket is not running.${NC}" >&2
    echo "" >&2
    echo "${BOLD}You may launch rocket using the following commands:${NC} './vendor/bin/rocket up' or './vendor/bin/rocket up -d'" >&2

    exit 1
}
# Define Docker Compose command prefix...
if ${ROCKET_DOCKER_BINARY} compose &> /dev/null; then
    COMPOSE_CMD=(${ROCKET_DOCKER_BINARY} compose)
else
    COMPOSE_CMD=(${ROCKET_DOCKER_BINARY}-compose)
fi


if [ -n "$ROCKET_FILES" ]; then
    # Convert ROCKET_FILES to an array...
    IFS=':' read -ra ROCKET_FILES <<< "$ROCKET_FILES"

    for FILE in "${ROCKET_FILES[@]}"; do
        if [ -f "$FILE" ]; then
            COMPOSE_CMD+=(-f "$FILE")
        else
            echo "${BOLD}Unable to find Docker Compose file: '${FILE}'${NC}" >&2

            exit 1
        fi
    done
fi

EXEC="yes"

# Proxy PHP commands to the "php" binary on the application container...
if [ "$1" == "php" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER")
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" "php")
    else
        rocket_is_not_running
    fi
# Proxy Composer commands to the "composer" binary on the application container...
elif [ "$1" == "composer" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER")
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" "composer")
    else
        rocket_is_not_running
    fi
# Proxy Artisan commands to the "artisan" binary on the application container...
elif [ "$1" == "artisan" ] || [ "$1" == "art" ] || [ "$1" == "a" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER")
        if [ ! -t 0 ] || [ "$1" == "schedule:run" ]; then
            ARGS+=(-T)
        fi
        
        ARGS+=("$APP_SERVICE" php artisan)
    else
        rocket_is_not_running
    fi

# Proxy the "debug" command to the "php artisan" binary on the application container with xdebug enabled...
elif [ "$1" == "debug" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER" -e XDEBUG_TRIGGER=1)
        [ ! -t 0 ] && ARGS+=(-T)
        
        ARGS+=("$APP_SERVICE" php artisan)
    else
        rocket_is_not_running
    fi
# Initiate a Bash shell within the application container...
elif [ "$1" == "shell" ] || [ "$1" == "bash" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER")
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" bash)
    else
        rocket_is_not_running
    fi
elif [ "$1" == "claude" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER")
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" claude)
    else
        rocket_is_not_running
    fi
elif [ "$1" == "yarn" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec -u "$APP_USER")
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" yarn)
    else
        rocket_is_not_running
    fi
elif [ "$1" == "mariadb" ]; then
    shift 1

    if [ "$EXEC" == "yes" ]; then
        ARGS+=(exec)
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=(mariadb bash -c)
        ARGS+=("MARIADB_PASSWORD=\${MARIADB_PASSWORD} mariadb -u \${MARIADB_USER} -p\${MARIADB_PASSWORD} \${MARIADB_DATABASE}")
    else
        rocket_is_not_running
    fi
fi

echo ${COMPOSE_CMD[@]} ${ARGS[@]} "$@"
# Run Docker Compose with the defined arguments...
"${COMPOSE_CMD[@]}" "${ARGS[@]}" "$@"
